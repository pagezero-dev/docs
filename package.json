{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "check": "astro check && oxlint && oxfmt --check",
    "check:fix": "oxlint --fix && oxfmt",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "reset": "git clean -fdxq && npm i",
    "start": "wrangler dev --port 3000",
    "setup": "bun install && playwright install --with-deps chromium",
    "git:clean": "git branch -l | grep -v 'main' | xargs git branch -D",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:ui": "playwright test --ui --project=e2e",
    "test:smoke": "playwright test --project=smoke"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/markdown-remark": "7.2.0",
    "@astrojs/starlight": "0.40.0",
    "astro": "6.4.6",
    "rehype-mermaid": "3.0.0",
    "sharp": "0.35.0",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "oxfmt": "0.60.0",
    "oxlint": "1.75.0",
    "wrangler": "4.59.1"
  }
}
