{
  "name": "docs",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "check": "astro check && oxlint && oxfmt --check",
    "check:fix": "oxlint --fix && oxfmt",
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "reset": "git clean -fdxq && npm i",
    "start": "wrangler dev --port 3000",
    "setup": "bun install && playwright install --with-deps chromium",
    "git:clean": "git branch -l | grep -v 'main' | xargs git branch -D",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:ui": "playwright test --ui --project=e2e",
    "test:smoke": "playwright test --project=smoke"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/starlight": "0.41.7",
    "astro": "7.2.1",
    "rehype-mermaid": "3.0.0",
    "sharp": "0.35.3",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "wrangler": "4.121.0"
  }
}
